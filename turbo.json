{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "biome.json"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "biome.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
